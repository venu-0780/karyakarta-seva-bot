{
  "version": "7.3",
  "screens": [
    {
      "id": "WHO",
      "title": "${data.title}",
      "data": {
        "title": { "type": "string", "__example__": "Register" },
        "intro": { "type": "string", "__example__": "Register to attend a press meet." },
        "name_label": { "type": "string", "__example__": "Your name" },
        "phone_label": { "type": "string", "__example__": "Mobile" },
        "next_label": { "type": "string", "__example__": "Next" },
        "event_title": { "type": "string", "__example__": "Event" },
        "constituency_label": { "type": "string", "__example__": "Constituency" },
        "attendees_label": { "type": "string", "__example__": "How many?" },
        "day_label": { "type": "string", "__example__": "Which day?" },
        "slots": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "today", "title": "Today" },
            { "id": "tomorrow", "title": "Tomorrow" },
            { "id": "either", "title": "Either" }
          ]
        },
        "register_label": { "type": "string", "__example__": "Register" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.intro}" },
          {
            "type": "Form",
            "name": "form",
            "children": [
              { "type": "TextInput", "name": "name", "label": "${data.name_label}", "required": true },
              { "type": "TextInput", "name": "phone", "label": "${data.phone_label}", "input-type": "phone", "required": true },
              {
                "type": "Footer",
                "label": "${data.next_label}",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "EVENT" },
                  "payload": { "name": "${form.name}", "phone": "${form.phone}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "EVENT",
      "title": "${screen.WHO.data.event_title}",
      "terminal": true,
      "success": true,
      "data": {
        "name": { "type": "string", "__example__": "Ravi" },
        "phone": { "type": "string", "__example__": "9876543210" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              { "type": "TextInput", "name": "constituency", "label": "${screen.WHO.data.constituency_label}", "required": true },
              { "type": "TextInput", "name": "attendees", "label": "${screen.WHO.data.attendees_label}", "input-type": "number", "required": true },
              {
                "type": "RadioButtonsGroup",
                "name": "slot",
                "label": "${screen.WHO.data.day_label}",
                "required": true,
                "data-source": "${screen.WHO.data.slots}"
              },
              {
                "type": "Footer",
                "label": "${screen.WHO.data.register_label}",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "name": "${data.name}",
                    "phone": "${data.phone}",
                    "constituency": "${form.constituency}",
                    "attendees": "${form.attendees}",
                    "slot": "${form.slot}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
