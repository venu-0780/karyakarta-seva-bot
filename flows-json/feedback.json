{
  "version": "7.3",
  "screens": [
    {
      "id": "TYPE",
      "title": "${data.title}",
      "data": {
        "title": { "type": "string", "__example__": "Feedback" },
        "intro": { "type": "string", "__example__": "Choose what this message is about." },
        "type_label": { "type": "string", "__example__": "Type" },
        "categories": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "complaint", "title": "Complaint" },
            { "id": "suggestion", "title": "Suggestion" },
            { "id": "feedback", "title": "Feedback" }
          ]
        },
        "next_label": { "type": "string", "__example__": "Next" },
        "details_title": { "type": "string", "__example__": "Details" },
        "details_label": { "type": "string", "__example__": "What happened?" },
        "details_help": { "type": "string", "__example__": "A sentence or two" },
        "contact_title": { "type": "string", "__example__": "Contact" },
        "reply_label": { "type": "string", "__example__": "How should we reply?" },
        "replies": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "whatsapp", "title": "WhatsApp" },
            { "id": "call", "title": "Phone call" }
          ]
        },
        "phone_label": { "type": "string", "__example__": "Phone (optional)" },
        "submit_label": { "type": "string", "__example__": "Submit" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.intro}" },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "category",
                "label": "${data.type_label}",
                "required": true,
                "data-source": "${data.categories}"
              },
              {
                "type": "Footer",
                "label": "${data.next_label}",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "DETAILS" },
                  "payload": { "category": "${form.category}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DETAILS",
      "title": "${screen.TYPE.data.details_title}",
      "data": {
        "category": { "type": "string", "__example__": "complaint" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextArea",
                "name": "details",
                "label": "${screen.TYPE.data.details_label}",
                "required": true,
                "helper-text": "${screen.TYPE.data.details_help}"
              },
              {
                "type": "Footer",
                "label": "${screen.TYPE.data.next_label}",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "CONTACT" },
                  "payload": {
                    "category": "${data.category}",
                    "details": "${form.details}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONTACT",
      "title": "${screen.TYPE.data.contact_title}",
      "terminal": true,
      "success": true,
      "data": {
        "category": { "type": "string", "__example__": "complaint" },
        "details": { "type": "string", "__example__": "Road repair is pending" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "callback",
                "label": "${screen.TYPE.data.reply_label}",
                "required": true,
                "data-source": "${screen.TYPE.data.replies}"
              },
              {
                "type": "TextInput",
                "name": "phone",
                "label": "${screen.TYPE.data.phone_label}",
                "input-type": "phone",
                "required": false
              },
              {
                "type": "Footer",
                "label": "${screen.TYPE.data.submit_label}",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "category": "${data.category}",
                    "details": "${data.details}",
                    "callback": "${form.callback}",
                    "phone": "${form.phone}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
