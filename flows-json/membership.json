{
  "version": "7.3",
  "screens": [
    {
      "id": "WHO",
      "title": "${data.title}",
      "data": {
        "title": { "type": "string", "__example__": "Membership" },
        "intro": { "type": "string", "__example__": "Apply for a membership ID card." },
        "name_label": { "type": "string", "__example__": "Full name" },
        "phone_label": { "type": "string", "__example__": "Mobile" },
        "next_label": { "type": "string", "__example__": "Next" },
        "place_title": { "type": "string", "__example__": "Address" },
        "constituency_label": { "type": "string", "__example__": "Constituency" },
        "address_label": { "type": "string", "__example__": "Address" },
        "consent_label": { "type": "string", "__example__": "I agree to be contacted" },
        "apply_label": { "type": "string", "__example__": "Apply" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.intro}" },
          {
            "type": "Form",
            "name": "form",
            "children": [
              { "type": "TextInput", "name": "name", "label": "${data.name_label}", "required": true },
              { "type": "TextInput", "name": "phone", "label": "${data.phone_label}", "input-type": "phone", "required": true },
              {
                "type": "Footer",
                "label": "${data.next_label}",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "PLACE" },
                  "payload": { "name": "${form.name}", "phone": "${form.phone}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PLACE",
      "title": "${screen.WHO.data.place_title}",
      "terminal": true,
      "success": true,
      "data": {
        "name": { "type": "string", "__example__": "Ravi Kumar" },
        "phone": { "type": "string", "__example__": "9876543210" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              { "type": "TextInput", "name": "constituency", "label": "${screen.WHO.data.constituency_label}", "required": true },
              { "type": "TextArea", "name": "address", "label": "${screen.WHO.data.address_label}", "required": true },
              { "type": "OptIn", "name": "consent", "label": "${screen.WHO.data.consent_label}", "required": true },
              {
                "type": "Footer",
                "label": "${screen.WHO.data.apply_label}",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "name": "${data.name}",
                    "phone": "${data.phone}",
                    "constituency": "${form.constituency}",
                    "address": "${form.address}",
                    "consent": "${form.consent}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
