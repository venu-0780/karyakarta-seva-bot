{
  "version": "7.3",
  "screens": [
    {
      "id": "ID_STATUS",
      "title": "${data.title}",
      "terminal": true,
      "success": true,
      "data": {
        "title": { "type": "string", "__example__": "ID status" },
        "intro": { "type": "string", "__example__": "Check your ID card status with your registered mobile number." },
        "mobile_label": { "type": "string", "__example__": "Mobile number" },
        "mobile_help": { "type": "string", "__example__": "10 digits, e.g. 9876543210" },
        "submit_label": { "type": "string", "__example__": "Check status" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.intro}" },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextInput",
                "name": "mobile",
                "label": "${data.mobile_label}",
                "input-type": "phone",
                "required": true,
                "helper-text": "${data.mobile_help}"
              },
              {
                "type": "Footer",
                "label": "${data.submit_label}",
                "on-click-action": {
                  "name": "complete",
                  "payload": { "mobile": "${form.mobile}" }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
