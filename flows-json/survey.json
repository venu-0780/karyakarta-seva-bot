{
  "version": "7.3",
  "screens": [
    {
      "id": "RATE",
      "title": "${data.title}",
      "data": {
        "title": { "type": "string", "__example__": "Rating" },
        "intro": { "type": "string", "__example__": "How useful is this helpdesk?" },
        "rating_label": { "type": "string", "__example__": "Rating" },
        "ratings": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "5", "title": "5 — Excellent" },
            { "id": "1", "title": "1 — Not useful" }
          ]
        },
        "next_label": { "type": "string", "__example__": "Next" },
        "note_title": { "type": "string", "__example__": "Comment" },
        "comment_label": { "type": "string", "__example__": "Anything else?" },
        "send_label": { "type": "string", "__example__": "Send" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.intro}" },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "rating",
                "label": "${data.rating_label}",
                "required": true,
                "data-source": "${data.ratings}"
              },
              {
                "type": "Footer",
                "label": "${data.next_label}",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "NOTE" },
                  "payload": { "rating": "${form.rating}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "NOTE",
      "title": "${screen.RATE.data.note_title}",
      "terminal": true,
      "success": true,
      "data": {
        "rating": { "type": "string", "__example__": "5" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextArea",
                "name": "comment",
                "label": "${screen.RATE.data.comment_label}",
                "required": false
              },
              {
                "type": "Footer",
                "label": "${screen.RATE.data.send_label}",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "rating": "${data.rating}",
                    "comment": "${form.comment}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
