# -----------------------------------------------------------------------------
# Environment variables for the Praja Seva Helpdesk bot.
# Copy to `.env` for local dev. On Vercel, set these in Project -> Settings ->
# Environment Variables (do NOT commit real values).
# -----------------------------------------------------------------------------

# --- WhatsApp Cloud API (from Meta -> your app -> WhatsApp -> API Setup) ------
# IMPORTANT: for an always-on deploy use a NON-EXPIRING System User token
# (Business Settings -> System Users -> Generate token). The temporary API-Setup
# token expires in ~24h and will take the deployed bot down.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; must match the token entered in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Display name only; keep it non-political so Meta review is smooth.
WHATSAPP_BOT_USERNAME=praja-seva-helpdesk

# --- Redis (REQUIRED in production / on Vercel) -------------------------------
# Serverless loses in-memory state between requests, so sessions must live in
# Redis. Use a standard TCP connection string, e.g. Upstash:
#   rediss://default:<password>@<host>.upstash.io:6379
# Leave blank for local dev to fall back to an in-memory store.
REDIS_URL=

# --- Optional tuning ----------------------------------------------------------
DEFAULT_LANG=te
ID_LOOKUPS_PER_HOUR=5
# Language code of your approved broadcast templates (en / en_US / te).
TEMPLATE_LANG=en
TEMPLATE_TALKING_POINTS=talking_points_daily
TEMPLATE_PRAJA_SANKALPAM=praja_sankalpam_daily
