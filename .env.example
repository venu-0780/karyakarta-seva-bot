# -----------------------------------------------------------------------------
# Environment variables for the Praja Seva Helpdesk bot.
# Copy to `.env` for local dev. On Vercel, set these in Project -> Settings ->
# Environment Variables (do NOT commit real values).
# -----------------------------------------------------------------------------

# --- WhatsApp Cloud API (from Meta -> your app -> WhatsApp -> API Setup) ------
# IMPORTANT: for an always-on deploy use a NON-EXPIRING System User token
# (Business Settings -> System Users -> Generate token). The temporary API-Setup
# token expires in ~24h and will take the deployed bot down.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Dialable business number, country code + number only. Used to discard CRM
# webhook echoes of the bot's own outbound messages.
WHATSAPP_BUSINESS_NUMBER=
# Keep the default for direct Meta Cloud API, or use the Meta-compatible API
# origin supplied by your BSP/CRM (without a trailing slash).
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_WABA_ID=
WHATSAPP_BUSINESS_ID=
# Any string you choose; must match the token entered in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Display name only; keep it non-political so Meta review is smooth.
WHATSAPP_BOT_USERNAME=praja-seva-helpdesk

# --- Redis (REQUIRED in production / on Vercel) -------------------------------
# Serverless loses in-memory state between requests, so sessions must live in
# Redis. Use a standard TCP connection string, e.g. Upstash:
#   rediss://default:<password>@<host>.upstash.io:6379
# Leave blank for local dev to fall back to an in-memory store.
REDIS_URL=

# --- LLM smart router (OPTIONAL) ----------------------------------------------
# When OPENAI_API_KEY is set, messages the regex matcher can't classify are sent
# to OpenAI, which maps them to one of the known flows (or asks a clarifying
# question). It only classifies intent — it never generates content and never
# receives phone numbers. Leave OPENAI_API_KEY blank to keep the bot fully
# deterministic (no external AI calls at all).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Hard timeout per classification call (ms); on timeout the bot degrades to the
# normal "didn't understand" reply.
LLM_TIMEOUT_MS=2500
# Max LLM classification calls per user per hour (cost / abuse guard).
LLM_CALLS_PER_HOUR=30
# Grounded answers: when a user ASKS about content (e.g. "what's in today's
# talking points?"), add a short summary built ONLY from the retrieved repo data
# (the source doc/links are still attached). Costs a second LLM call per such
# question. On by default when OPENAI_API_KEY is set; set to 0 to disable.
GROUNDED_ANSWERS=1

# --- Human handoff / escalation (OPTIONAL) ------------------------------------
# When set, a query the member chooses to escalate (or an "I want to talk to a
# coordinator" message) is forwarded to this coordinator's WhatsApp with the
# conversation context. Leave blank to still capture tickets without notifying.
# Use the coordinator's wa_id (country code + number, digits only).
COORDINATOR_WA_ID=

# --- Poll-result chart image (OPTIONAL) ---------------------------------------
# Poll results render as a real bar-chart image served from this deployment at
# /api/chart/poll/*. PUBLIC_BASE_URL is the public HTTPS origin WhatsApp fetches
# it from (set to your real domain on Vercel). Set CHART_IMAGES=0 to fall back
# to inline text / ASCII bars.
PUBLIC_BASE_URL=https://karyakarta-seva-bot.vercel.app
CHART_IMAGES=1

# --- Optional tuning ----------------------------------------------------------
DEFAULT_LANG=te
ID_LOOKUPS_PER_HOUR=5
# Language code of your approved broadcast / alert templates (en / en_US / te).
TEMPLATE_LANG=en
TEMPLATE_TALKING_POINTS=talking_points_daily
TEMPLATE_PRAJA_SANKALPAM=praja_sankalpam_daily
# Proactive-alert templates (see `npm run alert`). Must be pre-approved in
# WhatsApp Manager before they can be sent outside the 24h service window.
TEMPLATE_PRESS_LIVE=press_meet_live
TEMPLATE_ID_READY=id_card_ready
# Shared secret that guards POST /api/alerts/press-live (how you fire alerts on
# Vercel). Generate a long random string; the route refuses all requests until
# this is set. Send it as:  Authorization: Bearer <ALERTS_SECRET>
ALERTS_SECRET=
